# ===== Core =====
OPENAI_API_KEY=

# ===== Comunicación (LLM branches) =====
# Defaults reales si faltan:
# - COMM_CONTENT_OPENAI_ENABLED=false
# - COMM_AUDIO_OPENAI_ENABLED=false
# - COMM_SYNTHESIS_OPENAI_ENABLED=false
# - COMM_VISUAL_MODE=metadata
# - COMM_VISUAL_OPENAI_ENABLED=false
COMM_CONTENT_OPENAI_ENABLED=false
COMM_AUDIO_OPENAI_ENABLED=false
COMM_SYNTHESIS_OPENAI_ENABLED=false
COMM_VISUAL_MODE=metadata
COMM_VISUAL_OPENAI_ENABLED=false
# Ajustes visual LLM opcionales:
COMM_VISUAL_OPENAI_TIMEOUT_S=25
COMM_VISUAL_OPENAI_MAX_RETRIES=2

# ===== Public surface flags =====
# Railway v1 recomendado:
# ENABLE_AVATAR_APP=0
# ENABLE_OPTIMIZADOR_APP=0
ENABLE_AVATAR_APP=1
ENABLE_OPTIMIZADOR_APP=1

# ===== OpenAI speech (opcional, con defaults en código) =====
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_FORMAT=wav
OPENAI_TTS_SPEED=1.10
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ===== Google STT (opcional; prioridad: JSON inline > path local > fallback OpenAI STT) =====
# Railway: pega aquí el JSON completo de la service account en una sola variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local: usa ruta a archivo JSON si no quieres incrustar el contenido.
GOOGLE_CREDENTIALS_PATH=
GOOGLE_STT_MODEL=latest_long
GOOGLE_STT_LANGUAGE=es-ES
GOOGLE_STT_PUNCTUATION=true
GOOGLE_STT_ENCODING=WEBM_OPUS
