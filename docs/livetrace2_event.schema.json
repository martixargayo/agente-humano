{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agente-humano.local/schemas/livetrace2_event.schema.json",
  "title": "LiveTrace2 Turn Event",
  "type": "object",
  "required": [
    "trace_schema_version",
    "trace_id",
    "turn_id",
    "user_id",
    "session_id",
    "turn_idx",
    "nodes"
  ],
  "properties": {
    "trace_schema_version": {
      "const": "livetrace2-v1"
    },
    "trace_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "trace_index": {
      "type": "integer"
    },
    "turn_idx": {
      "type": "integer"
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "total_latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trace_id",
          "session_id",
          "turn_idx",
          "node_id",
          "node_name",
          "node_type",
          "status",
          "started_at",
          "ended_at",
          "latency_ms",
          "sequence_index",
          "redaction_applied",
          "redaction_policy_id",
          "input_capture_state",
          "output_capture_state",
          "fields_redacted"
        ],
        "properties": {
          "trace_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "turn_idx": {
            "type": "integer"
          },
          "node_id": {
            "type": "string"
          },
          "node_name": {
            "type": "string"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "llm_call",
              "gate",
              "tool_call"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "skipped",
              "timeout",
              "executed"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0
          },
          "sequence_index": {
            "type": "integer",
            "minimum": 0
          },
          "input_prompt_rendered": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_payload_raw": {},
          "output_text_rendered": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_payload_raw": {},
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokens_in": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens_out": {
            "type": [
              "integer",
              "null"
            ]
          },
          "retry_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "error_stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ttfb_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "gate_rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "gate_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "gate_inputs": {},
          "gate_decision": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "",
              "executed",
              "skipped"
            ]
          },
          "gate_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "gate_reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "redaction_applied": {
            "type": "boolean"
          },
          "redaction_policy_id": {
            "type": "string"
          },
          "prev_node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_text_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_payload_parsed": {},
          "fields_redacted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_capture_state": {
            "type": "string",
            "enum": [
              "captured",
              "not_captured",
              "redacted",
              "truncated"
            ]
          },
          "output_capture_state": {
            "type": "string",
            "enum": [
              "captured",
              "not_captured",
              "redacted",
              "truncated"
            ]
          },
          "input_truncation": {
            "type": [
              "object",
              "null"
            ]
          },
          "output_truncation": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "world_parallelism": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "tasks": {
          "type": "object"
        },
        "fallback_to_sequential": {
          "type": "boolean"
        },
        "fallback_reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sum_ms": {
          "type": "integer"
        },
        "critical_path_ms": {
          "type": "integer"
        },
        "overlap_ms": {
          "type": "integer"
        },
        "saved_ms_estimate": {
          "type": "integer"
        }
      }
    }
  }
}